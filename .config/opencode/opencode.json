{
  "$schema": "https://opencode.ai/config.json",
  "model": "google/gemini-3-pro-preview",
  "instructions": [
    "AGENTS.md",
    "CLAUDE.md",
    "README.md"
  ],
  "permission": {
    "bash": "ask",
    "write": "allow",
